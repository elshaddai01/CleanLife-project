NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cleanlife_db
DATABASE_SSL=false

# Bypasses the real GPS geofence check on proof-of-work when true. Defaults
# to true if unset — MUST be explicitly set to false for any real deployment,
# otherwise disposal location is never actually verified.
AUTO_VERIFY_GPS_PROOF=false
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
ADMIN_API_KEY=change_this_to_a_long_random_admin_key
MOMO_WEBHOOK_SECRET=change_this_to_a_long_random_webhook_secret
CORS_ORIGIN=*

# PostgreSQL-backed dispatch timing.
DISPATCH_POLL_MS=15000
ADMIN_HOLD_MS=120000
TIER_CASCADE_STEP_MS=300000

# Real pawaPay MoMo integration — copy your team's real token here.
# Get PAWAPAY_TOKEN from your pawaPay dashboard. Never commit the real
# value to git — this file is just a template.
PAWAPAY_TOKEN=your_pawapay_bearer_token_here
PAWAPAY_BASE_URL=https://api.pawapay.io

# Real SMTP email delivery — used to send the registration OTP code.
# For Gmail: use an App Password (not your normal password), SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=CleanLife <no-reply@cleanlife.example.com>
