PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cleanlife_db
DATABASE_SSL=false
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
ADMIN_API_KEY=change_this_to_a_long_random_admin_key
MOMO_WEBHOOK_SECRET=change_this_to_a_long_random_webhook_secret
CORS_ORIGIN=*

# Gmail example: use a Gmail App Password, not your normal password.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=CleanLife <your-email@gmail.com>

# PostgreSQL-backed dispatch timing.
DISPATCH_POLL_MS=15000
ADMIN_HOLD_MS=120000
TIER_CASCADE_STEP_MS=30000


AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=CleanLife
